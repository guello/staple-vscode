{
  "name": "staple-vscode",
  "displayName": "Staple",
  "version": "0.1.0",
  "description": "Essential VS Code utilities packaged as a single lightweight, performant extension",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "publisher": "guello",
  "repository": {
    "type": "https",
    "url": "https://github.com/guello/staple-vscode"
  },
  "icon": "./media/icon.png",
  "main": "./dist/extension.js",
  "packageManager": "pnpm@11.17.0",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "node scripts/build.mts",
    "watch": "node scripts/build.mts --watch",
    "generate:ghostty": "node scripts/generate-ghostty-reference.mts",
    "check": "pnpm run --parallel \"/^check:/\"",
    "check:format": "oxfmt --check",
    "check:knip": "knip",
    "check:lint": "oxlint",
    "check:types": "tsc --noEmit",
    "fix": "oxlint --fix && oxfmt",
    "test": "node scripts/test.mts",
    "ci": "pnpm run check && pnpm run test",
    "deploy": "pnpm run package && code --install-extension staple-vscode-$npm_package_version.vsix",
    "package": "pnpm run ci && vsce package --no-dependencies",
    "vscode:prepublish": "pnpm run build"
  },
  "dependencies": {
    "@taplo/lsp": "^0.8.0",
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.2.0",
    "@types/vscode": "~1.91.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "generate-github-markdown-css": "^6.6.0",
    "knip": "^6.32.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.26",
    "typescript": "^7.0.2"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ghostty",
        "aliases": [
          "Ghostty Config",
          "ghostty"
        ],
        "extensions": [
          ".ghostty"
        ],
        "firstLine": "^#\\s*(vim?:\\s*(set\\s+)?ft=ghostty|-\\*-\\s*(mode:\\s*)?ghostty\\s*-\\*-)",
        "configuration": "./languages/ghostty/language-configuration.json"
      },
      {
        "id": "toml",
        "aliases": [
          "TOML"
        ],
        "extensions": [
          ".toml"
        ],
        "filenames": [
          "Cargo.lock",
          "uv.lock"
        ],
        "configuration": "./languages/toml/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ghostty",
        "scopeName": "source.ghostty",
        "path": "./languages/ghostty/ghostty.tmLanguage.json"
      },
      {
        "language": "toml",
        "scopeName": "source.toml",
        "path": "./languages/toml/toml.tmLanguage.json"
      },
      {
        "scopeName": "markdown.toml.frontmatter.codeblock",
        "path": "./languages/toml/markdown-frontmatter.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      },
      {
        "scopeName": "markdown.toml.codeblock",
        "path": "./languages/toml/markdown-codeblock.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.toml": "toml"
        }
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./dist/features/markdown/markdown.css",
      "./dist/features/markdown/themes.css",
      "./media/markdown/preview.css",
      "./media/markdown/syntax-highlighting.css",
      "./media/markdown/task-lists.css"
    ],
    "commands": [
      {
        "command": "staple.toggleQuotes",
        "title": "Toggle Quotes",
        "category": "Staple"
      },
      {
        "command": "staple.optimizeImage",
        "title": "Optimize Image",
        "category": "Staple"
      },
      {
        "command": "staple.optimizeFolderImages",
        "title": "Optimize Images in Folder",
        "category": "Staple"
      },
      {
        "command": "staple.sortObjectsByKey",
        "title": "Sort Objects By Key",
        "category": "Staple",
        "enablement": "config.staple.sortObjectsByKey.enabled && !editorReadonly && (editorLangId == json || config.staple.sortObjectsByKey.allowNonJson)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "staple.optimizeImage",
          "when": "config.staple.optimizeImages.app && !explorerResourceIsFolder && resourceExtname =~ /\\.(png|jpe?g|gif|svg|webp|avif|tiff?|bmp)$/i",
          "group": "7_modification"
        },
        {
          "command": "staple.optimizeFolderImages",
          "when": "config.staple.optimizeImages.app && explorerResourceIsFolder",
          "group": "7_modification"
        }
      ],
      "editor/title/context": [
        {
          "command": "staple.optimizeImage",
          "when": "config.staple.optimizeImages.app && resourceExtname =~ /\\.(png|jpe?g|gif|svg|webp|avif|tiff?|bmp)$/i",
          "group": "7_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "staple.optimizeImage",
          "when": "config.staple.optimizeImages.app"
        },
        {
          "command": "staple.optimizeFolderImages",
          "when": "false"
        },
        {
          "command": "staple.sortObjectsByKey",
          "when": "config.staple.sortObjectsByKey.enabled && (editorLangId == json || config.staple.sortObjectsByKey.allowNonJson)"
        }
      ]
    },
    "keybindings": [
      {
        "command": "staple.toggleQuotes",
        "key": "ctrl+'",
        "mac": "cmd+'",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Staple",
      "properties": {
        "staple.instantGitRefresh.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Refresh the built-in Git view immediately when a repository changes outside VS Code."
        },
        "staple.instantGitRefresh.delay": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "maximum": 5000,
          "scope": "resource",
          "description": "Debounce delay in milliseconds between a detected .git change and the forced refresh."
        },
        "staple.ghosttySyntax.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Enable Ghostty config support."
        },
        "staple.ghosttySyntax.autoAssociations": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Add files.associations entries so the config file and theme files inside a ghostty directory use the Ghostty language, including in the file explorer. Disabling removes the entries this extension added."
        },
        "staple.optimizeImages.app": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Name of the optimizer app to open images with, for example \"ImageOptim\". The feature stays hidden until this is set. Machine-scoped so a workspace cannot point it at an arbitrary executable."
        },
        "staple.optimizeImages.imageRegex": {
          "type": "string",
          "default": "\\.(png|jpe?g|gif|svg|webp|avif|tiff?|bmp)$",
          "scope": "resource",
          "description": "Case-insensitive regex matching image files found when optimizing a folder."
        },
        "staple.optimizeImages.searchIgnoreFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git",
            ".svn",
            "node_modules",
            "bower_components"
          ],
          "scope": "resource",
          "description": "Folder names skipped when searching a folder recursively."
        },
        "staple.optimizeImages.confirmThreshold": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "scope": "resource",
          "description": "Ask for confirmation before optimizing a folder that contains more than this many images."
        },
        "staple.sortObjectsByKey.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable the Sort Objects By Key command."
        },
        "staple.sortObjectsByKey.allowNonJson": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Allow the Sort Objects By Key command outside the JSON language mode. The file contents must still be valid JSON."
        },
        "staple.toml.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable TOML diagnostics, formatting, completion, hover, folding, outline navigation, and symbol renaming."
        },
        "staple.toml.completion.maxKeys": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "scope": "resource",
          "description": "Maximum number of dotted keys shown in a TOML completion item. Set to 0 to disable key completions."
        },
        "staple.toml.schema.links": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Show schema-provided links on TOML keys."
        },
        "staple.toml.schema.cache.memoryExpiration": {
          "type": "integer",
          "default": 60,
          "minimum": 0,
          "scope": "resource",
          "description": "Seconds before an in-memory TOML schema cache entry expires."
        },
        "staple.toml.schema.cache.diskExpiration": {
          "type": "integer",
          "default": 600,
          "minimum": 0,
          "scope": "resource",
          "description": "Seconds before a cached TOML schema is fetched again."
        },
        "staple.toml.formatter.alignEntries": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "description": "Align consecutive TOML entries vertically."
        },
        "staple.toml.formatter.alignComments": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "description": "Align consecutive trailing comments vertically."
        },
        "staple.toml.formatter.arrayTrailingComma": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "description": "Add trailing commas to multiline arrays."
        },
        "staple.toml.formatter.arrayAutoExpand": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "description": "Expand arrays to multiple lines when needed."
        },
        "staple.toml.formatter.inlineTableExpand": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "description": "Expand inline table values to multiple lines."
        },
        "staple.toml.formatter.arrayAutoCollapse": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "description": "Collapse arrays that fit on one line."
        },
        "staple.toml.formatter.compactArrays": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "description": "Omit padding inside single-line arrays."
        },
        "staple.toml.formatter.compactInlineTables": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "description": "Omit padding inside inline tables."
        },
        "staple.toml.formatter.compactEntries": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "description": "Omit spaces around entry equals signs."
        },
        "staple.toml.formatter.columnWidth": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 1,
          "scope": "resource",
          "description": "Target column width used when expanding arrays."
        },
        "staple.toml.formatter.indentTables": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "description": "Indent subtables when they appear in order."
        },
        "staple.toml.formatter.indentEntries": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "description": "Indent entries under their tables."
        },
        "staple.toml.formatter.indentString": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "description": "Indentation string. By default, the editor tab size and space setting are used."
        },
        "staple.toml.formatter.trailingNewline": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "description": "Add a trailing newline."
        },
        "staple.toml.formatter.reorderKeys": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "description": "Sort keys that are not separated by blank lines."
        },
        "staple.toml.formatter.reorderArrays": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "description": "Sort array values that are not separated by blank lines."
        },
        "staple.toml.formatter.reorderInlineTables": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "description": "Sort inline table entries."
        },
        "staple.toml.formatter.allowedBlankLines": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "scope": "resource",
          "description": "Maximum number of consecutive blank lines."
        },
        "staple.toml.formatter.crlf": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "description": "Use CRLF line endings."
        },
        "staple.markdown.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Enable the Markdown preview features. Turning it off restores the built-in preview."
        },
        "staple.markdown.mode": {
          "type": "string",
          "enum": [
            "auto",
            "system",
            "light",
            "dark"
          ],
          "enumItemLabels": [
            "Auto (match editor)",
            "System",
            "Single theme: Light",
            "Single theme: Dark"
          ],
          "enumDescriptions": [
            "Follow the active VS Code color theme.",
            "Follow the operating system color scheme.",
            "Always use the configured light theme.",
            "Always use the configured dark theme."
          ],
          "default": "auto",
          "scope": "window",
          "description": "How the Markdown preview picks between the light and dark theme."
        },
        "staple.markdown.lightTheme": {
          "type": "string",
          "enum": [
            "default",
            "github-light",
            "github-light-high-contrast",
            "github-light-colorblind",
            "github-light-tritanopia",
            "github-dark",
            "github-dark-high-contrast",
            "github-dark-colorblind",
            "github-dark-tritanopia",
            "github-dark-dimmed"
          ],
          "enumItemLabels": [
            "Default (VS Code)",
            "GitHub Light",
            "GitHub Light high contrast",
            "GitHub Light Protanopia and Deuteranopia",
            "GitHub Light Tritanopia",
            "GitHub Dark",
            "GitHub Dark high contrast",
            "GitHub Dark Protanopia and Deuteranopia",
            "GitHub Dark Tritanopia",
            "GitHub Dark dimmed"
          ],
          "enumDescriptions": [
            "Leave the preview with the built-in VS Code styling.",
            "Style the preview with the GitHub Light theme.",
            "Style the preview with the GitHub Light high contrast theme.",
            "Style the preview with the GitHub Light Protanopia and Deuteranopia theme.",
            "Style the preview with the GitHub Light Tritanopia theme.",
            "Style the preview with the GitHub Dark theme.",
            "Style the preview with the GitHub Dark high contrast theme.",
            "Style the preview with the GitHub Dark Protanopia and Deuteranopia theme.",
            "Style the preview with the GitHub Dark Tritanopia theme.",
            "Style the preview with the GitHub Dark dimmed theme."
          ],
          "default": "github-light",
          "scope": "window",
          "markdownDescription": "Theme used whenever the preview resolves to light. Ignored when `#staple.markdown.mode#` is `Single theme: Dark`."
        },
        "staple.markdown.darkTheme": {
          "type": "string",
          "enum": [
            "default",
            "github-light",
            "github-light-high-contrast",
            "github-light-colorblind",
            "github-light-tritanopia",
            "github-dark",
            "github-dark-high-contrast",
            "github-dark-colorblind",
            "github-dark-tritanopia",
            "github-dark-dimmed"
          ],
          "enumItemLabels": [
            "Default (VS Code)",
            "GitHub Light",
            "GitHub Light high contrast",
            "GitHub Light Protanopia and Deuteranopia",
            "GitHub Light Tritanopia",
            "GitHub Dark",
            "GitHub Dark high contrast",
            "GitHub Dark Protanopia and Deuteranopia",
            "GitHub Dark Tritanopia",
            "GitHub Dark dimmed"
          ],
          "enumDescriptions": [
            "Leave the preview with the built-in VS Code styling.",
            "Style the preview with the GitHub Light theme.",
            "Style the preview with the GitHub Light high contrast theme.",
            "Style the preview with the GitHub Light Protanopia and Deuteranopia theme.",
            "Style the preview with the GitHub Light Tritanopia theme.",
            "Style the preview with the GitHub Dark theme.",
            "Style the preview with the GitHub Dark high contrast theme.",
            "Style the preview with the GitHub Dark Protanopia and Deuteranopia theme.",
            "Style the preview with the GitHub Dark Tritanopia theme.",
            "Style the preview with the GitHub Dark dimmed theme."
          ],
          "default": "github-dark",
          "scope": "window",
          "markdownDescription": "Theme used whenever the preview resolves to dark. Ignored when `#staple.markdown.mode#` is `Single theme: Light`."
        },
        "staple.markdown.taskLists": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Render `- [ ]` and `- [x]` list items as checkboxes. Works with every theme."
        },
        "staple.markdown.checkboxes": {
          "type": "object",
          "default": {
            " ": "unchecked",
            "x": "checked",
            "X": "checked",
            "-": "indeterminate",
            "/": "indeterminate",
            "~": "cancelled"
          },
          "propertyNames": {
            "minLength": 1,
            "maxLength": 1,
            "description": "The single character written between the brackets."
          },
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "unchecked",
              "checked",
              "indeterminate",
              "cancelled",
              null
            ],
            "enumDescriptions": [
              "An empty box.",
              "A filled box with a check mark.",
              "A filled box with a dash, for partly done work.",
              "A slashed box with the label struck through.",
              "Stop recognizing this character."
            ]
          },
          "scope": "window",
          "markdownDescription": "Maps the character between the brackets of a task list item to the checkbox drawn for it. Your entries merge with the defaults, so `{ \"?\": \"indeterminate\" }` adds a character and `{ \"/\": null }` drops one. Only `[ ]` and `[x]` are GitHub Flavored Markdown; a file using any other character renders as literal text on github.com. Requires `#staple.markdown.taskLists#`."
        },
        "staple.toggleQuotes.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "language-overridable",
          "description": "Enable the Toggle Quotes command."
        },
        "staple.toggleQuotes.chars": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 2,
                "maxItems": 2
              }
            ]
          },
          "default": [
            "\"",
            "'"
          ],
          "scope": "language-overridable",
          "description": "Quote characters to cycle through. Each entry is a single character or a [begin, end] pair."
        }
      }
    },
    "configurationDefaults": {
      "[javascript]": {
        "staple.toggleQuotes.chars": [
          "\"",
          "'",
          "`"
        ]
      },
      "[javascriptreact]": {
        "staple.toggleQuotes.chars": [
          "\"",
          "'",
          "`"
        ]
      },
      "[typescript]": {
        "staple.toggleQuotes.chars": [
          "\"",
          "'",
          "`"
        ]
      },
      "[typescriptreact]": {
        "staple.toggleQuotes.chars": [
          "\"",
          "'",
          "`"
        ]
      },
      "[vue]": {
        "staple.toggleQuotes.chars": [
          "\"",
          "'",
          "`"
        ]
      },
      "[markdown]": {
        "staple.toggleQuotes.chars": [
          "\"",
          "'",
          "`"
        ]
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
